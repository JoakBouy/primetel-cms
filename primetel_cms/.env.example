# ─────────────────────────────────────────────────────────────────
# Primetel CMS — environment variable reference
# ─────────────────────────────────────────────────────────────────
# Copy to .env for local development. For Render, set these in the
# Render dashboard under the service's Environment tab — DO NOT
# commit production secrets to git. .env is gitignored.
#
# Required vs optional is noted on each line.
# ─────────────────────────────────────────────────────────────────

# ─── Django core ─────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-real-secret-key   # required; Render generates one automatically
DEBUG=True                                  # required; False in production
DJANGO_SETTINGS_MODULE=config.settings.dev  # required; set to config.settings.prod in production
ALLOWED_HOSTS=localhost,127.0.0.1           # required; comma-separated, e.g. primetel-cms.onrender.com

# ─── Database ─────────────────────────────────────────────────────
# Local: SQLite is fine.
# Production: Supabase Postgres SESSION POOLER URL (port 5432). NOT the
# transaction pooler (6543) — it breaks select_for_update.
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///db.sqlite3           # required

# ─── Session security ────────────────────────────────────────────
IDLE_SESSION_SECONDS=900                    # optional; default 900 (15 min). Idle re-auth window.
TRUSTED_PROXY_COUNT=0                       # optional; 0 locally, 1 on Render (2 behind proxied Cloudflare)

# ─── Uploaded files (production) ─────────────────────────────────
# Render's disk is wiped on every deploy. Use a PRIVATE Supabase Storage
# bucket (S3-compatible: Project Settings → Storage → S3 Connection).
# Leave blank locally to store uploads in ./media.
MEDIA_S3_BUCKET=                            # optional locally; required in production
MEDIA_S3_ENDPOINT_URL=                      # e.g. https://<ref>.supabase.co/storage/v1/s3
MEDIA_S3_REGION=                            # e.g. eu-central-1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# ─── Danger zone ─────────────────────────────────────────────────
ALLOW_FACTORY_RESET=false                   # admin wipe button; dev defaults to true, prod to false

# ─── First-deploy admin bootstrap (Render) ───────────────────────
# Used by `python manage.py bootstrap_admin` during the build to
# create the initial superuser without shell access. Only the FIRST
# build uses these — later changes are ignored to prevent take-over
# via build access.
BOOTSTRAP_ADMIN_USERNAME=admin              # optional; default 'admin'
BOOTSTRAP_ADMIN_EMAIL=admin@example.com     # required for first deploy
BOOTSTRAP_ADMIN_PASSWORD=                   # required for first deploy; pick a strong one

# ─── Error reporting (optional) ──────────────────────────────────
SENTRY_DSN=                                 # optional; leave blank to disable
SENTRY_ENV=production                       # optional
SENTRY_TRACES_SAMPLE_RATE=0.0               # optional; 0.0 = no perf traces

# ─── Render-specific (auto-set by Render) ────────────────────────
# Render injects RENDER_EXTERNAL_HOSTNAME at runtime, so prod.py adds
# it to ALLOWED_HOSTS automatically. You don't need to set this manually.
# RENDER_EXTERNAL_HOSTNAME=primetel-cms.onrender.com
